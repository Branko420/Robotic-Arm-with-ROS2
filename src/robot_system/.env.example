# Shared infrastructure
REDIS_URL=redis://127.0.0.1:6379/0
ROBOT_SYSTEM_ENV_FILE=/workspace/.env

# Physical arm
PLANNER_SEND_TO_REAL=true
PLANNER_PI_IP=192.168.188.144
PLANNER_PI_PORT=9090
PHYSICAL_ARM_REQUIRE_AVAILABLE=true
PLANNER_REAL_MOVE_DURATION_SEC=10.0
PLANNER_REAL_GRIPPER_DURATION_SEC=2.0
PLANNER_PICK_GRIPPER_OPEN_SERVO_DEG=70.0
PLANNER_GRIPPER_OPEN_SERVO_DEG=70.0
PLANNER_MANUAL_JOINT_MOVE_DURATION_SEC=3.0

# Named poses and scan flow
SCAN_POSE_MIN_DWELL_SEC=7.0
POSE_MATCH_TOLERANCE_DEG=2.0
SCAN_AFTER_HOME_SETTLE_SEC=0.8

# Object planning
HELD_OBJECT_KEY=workspace:held_object
PLANNER_ABOVE_OBJECT_CLEARANCE_M=0.10
PLANNER_MIN_ABOVE_CLEARANCE_M=0.06
PLANNER_PLACE_CLEARANCE=0.012
PLANNER_PLACE_APPROACH_HEIGHT=0.10
PLANNER_TRANSIT_CLEARANCE_M=0.04
PLANNER_TRANSIT_CORRIDOR_MARGIN_M=0.025
PLANNER_MAX_TRANSIT_Z_M=0.34

# Direct RViz RobotModel state output from planning_agent
PLANNER_PUBLISH_MODEL_JOINT_STATES=true
PLANNER_MODEL_JOINT_STATE_RATE_HZ=30.0

# Position-aware planning
PLANNER_PICK_VERTICAL_CLEARANCE_M=0.03
PLANNER_GRIPPER_OPEN_SERVO_DEG=70.0
PLANNER_GRIPPER_CLOSE_SERVO_DEG=130.0
CURRENT_POSE_KEY=workspace:current_end_effector_pose
SAVED_POINTS_KEY=workspace:saved_cartesian_points

# Realtime interruption
REALTIME_BARGE_IN_ENABLED=true
REALTIME_CANCEL_MOTION_ON_BARGE_IN=true

SIMPLE_OBJECT_MAX_BASE_DISTANCE_M=0.40
PLANNER_MAX_TARGET_BASE_DISTANCE_M=0.40
INSTANCE_MATCH_MAX_DISTANCE_M=0.06

CLEAR_OBJECT_STATE_BEFORE_SCAN=true
CLEAR_TARGET_OFFSETS_BEFORE_SCAN=true
PLANNER_PICK_USE_EXACT_OBJECT_CENTER=true
PLANNER_ALLOW_BEST_EFFORT=false
PLANNER_MAX_POSITION_ERROR=0.008
PLANNER_HARD_MAX_TARGET_ERROR_M=0.008
